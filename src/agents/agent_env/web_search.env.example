# Text2SQL Agent 환경변수 설정
# 이 파일을 복사하여 text2sql.env 파일을 생성하세요.

# Text2SQL 전용 모델 선택
# - "openai" 또는 "cohere" → 루트 .env의 OPENAI_MODEL / COHERE_MODEL 값을 자동 사용
# - "openai:gpt-4o-mini" → 특정 모델을 직접 지정 (루트 .env 값을 오버라이드)
# - 미설정 시 공통 MODEL/COHERE_MODEL 규칙을 따릅니다.
# - API 키/엔드포인트는 루트 .env(공통 LLM 설정)에서 관리합니다.
TEXT2SQL_MODEL_ID=openai

# Text2SQL 전용 DB 설정 (권장: TEXT2SQL_DB_* 사용)
TEXT2SQL_DB_DIALECT=postgresql   # postgresql | mariadb
TEXT2SQL_DB_HOST=your-db-host
TEXT2SQL_DB_PORT=5432
TEXT2SQL_DB_NAME=your-db-name
TEXT2SQL_DB_USER=your-db-user
TEXT2SQL_DB_PASSWORD=your-db-password

# SQL 실행 실패 시 최대 재시도 횟수 (기본값 10)
TEXT2SQL_MAX_RETRY_COUNT=10
