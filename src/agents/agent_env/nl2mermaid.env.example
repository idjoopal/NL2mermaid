# NL2Mermaid Agent 환경변수 설정
# 이 파일을 복사하여 nl2mermaid.env 파일을 생성하세요.
# cp src/agents/agent_env/nl2mermaid.env.example src/agents/agent_env/nl2mermaid.env

# LLM 모델 선택
# - "openai:gpt-4o-mini" : GPT-4o mini (기본, 빠름·저렴)
# - "openai:gpt-4o"      : GPT-4o (고품질)
# - "cohere"             : 루트 .env의 COHERE_MODEL 사용
NL2MERMAID_MODEL_ID=openai:gpt-4o-mini

# 렌더링 프로바이더
# - mermaid_ink : 공개 API (기본, 설치 불필요)
# - kroki       : POST 방식, 자체 호스팅 가능
RENDERER_PROVIDER=mermaid_ink

# 렌더링 결과 저장 디렉토리
RENDERER_OUTPUT_DIR=./output
