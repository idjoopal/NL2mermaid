# 서버 레벨 설정 (모든 tool에 공통)
APP_ENV=dev

# 서버 실행 설정 (dev)
SERVER_HOST=0.0.0.0
SERVER_PORT=9101

# 공통 LLM 기본값 (mainly Cohere path)
CLIENT_NAME=prebuilt-mcp
API_KEY=
TEMPERATURE=0.0
TIMEOUT=120
MODEL=command
TOP_K=1
THINKING=false
MAX_TOKENS=2048

BASE_URL=http://your-cohere-endpoint
# 집현 모델 http://command.north.svc.cluster.local
# North Large 모델 http://north-large-01-2026.north.svc.cluster.local

# (선택) Cohere 전용 키를 명시적으로 분리해도 됩니다.
# COHERE_API_KEY=
# COHERE_BASE_URL=
# COHERE_MODEL=command-r-plus
# COHERE_CLIENT_NAME=prebuilt-mcp

# OpenAI 설정 (Text2SQL에서 openai:* 모델을 쓸 때 필요)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 주의:
# - text2sql 전용 DB/모델은 src/agents/env/text2sql.env 에 설정합니다.
# - agent(env)에서는 어떤 모델을 쓸지만 선택하고, API 키/엔드포인트는 이 파일에서 관리합니다.
